              </div>
              
              <!-- BANKE BILGILERI KUTUSU -->
              <div style="background: var(--input-bg); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; margin-bottom: 2rem;">
                <div style="display:flex; justify-content:space-between; margin-bottom: 0.8rem;">
                  <span style="color:var(--muted); font-size:0.9rem;">Banka:</span>
                  <span style="color:var(--text); font-weight:500;">AKBANK ALTUNİZADE</span>
                </div>
                <div style="display:flex; justify-content:space-between; margin-bottom: 0.8rem;">
