              </div>
              <div class="step-btns">
                <button type="button" class="btn-ghost" onclick="nextStep(3)"><i class="bi bi-arrow-left me-2"></i> Geri</button>
                <button type="button" class="btn-red" onclick="validateStep(4)"><i class="bi bi-check2-circle me-2"></i> Gönder</button>
