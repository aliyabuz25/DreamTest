                </div>
                <div style="background: rgba(230,57,70,0.1); border: 1px solid rgba(230,57,70,0.2); padding: 1rem; border-radius: 12px; color: #d32f2f; font-size:0.9rem; text-align:center;">
                  Açıklama Kısmına <strong>Sipariş Takip Kodunuzu</strong> Yazmayı Unutmayınız!
                </div>
              </div>

              <div class="tracking-box" style="padding: 2rem 0; margin-bottom: 1.5rem;">
                <div class="tracking-label">Sipariş Takip Kodu</div>
                <div class="tracking-code" id="trackingCode"></div>
                <button type="button" class="copy-btn" onclick="copyCode()">Kodu Kopyala</button>
              </div>
              
              <div class="tracking-link-box" style="margin-top: 1rem;">
                <a id="trackingLink" href="#" target="_blank">Takip Sayfasına Git <i class="bi bi-arrow-up-right ms-1"></i></a>
              </div>
              
              <div style="text-align:center;margin-top:2rem;">
                <a href="javascript:void(0)" onclick="goHome()" style="color:var(--muted);text-decoration:none;font-size:0.95rem;transition:color 0.3s;border-bottom:1px solid transparent;padding-bottom:2px;" onmouseover="this.style.color='#000';this.style.borderColor='#000'" onmouseout="this.style.color='var(--muted)';this.style.borderColor='transparent'">Ana Sayfaya Dön</a>
              </div>
            </div>

          </form>
        </div>
      </div>
    </div> <!-- View 2 End -->

    <!-- VIEW 3: PRESS (BASINDA BİZ) -->
