  }

  // ── SPA SLIDER MANTIĞI ──
  function goToForm() {
    document.getElementById('pageSlider').style.transform = 'translateX(-100vw)';
    setTimeout(() => {
      document.querySelector('.view-form').scrollTop = 0;
    }, 400);
  }

  function goToPress() {
    document.getElementById('pageSlider').style.transform = 'translateX(-200vw)';
    setTimeout(() => {
      document.querySelector('.view-press').scrollTop = 0;
    }, 400);
  }

  function goHome() {
    document.getElementById('pageSlider').style.transform = 'translateX(0)';
    setTimeout(() => {
      // Formu sıfırla
      document.getElementById('orderForm').reset();
      nextStep(1);
    }, 800);
  }

  // ── FORM MANTIĞI (ÖNCEKİ KODLAR) ──
  let currentStep = 1;
  const TOTAL_STEPS = 5;
  let uploadedPhotos = {};
  
  const phoneInput = window.intlTelInput(document.querySelector("#f-phone"), {
    initialCountry: "tr",
    preferredCountries: ["tr", "de", "gb", "us"],
    utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@19.2.16/build/js/utils.js",
    separateDialCode: true,
    customPlaceholder: function(selectedCountryPlaceholder, selectedCountryData) {
      return "Örn: " + selectedCountryPlaceholder;
    },
  });

  const elYear = document.getElementById('f-year');
  const elMake = document.getElementById('f-make');
  const elModel = document.getElementById('f-model');

  const currentYear = new Date().getFullYear();
  for (let i = currentYear; i >= 1990; i--) {
    const opt = document.createElement('option');
    opt.value = i;
    opt.textContent = i;
    elYear.appendChild(opt);
  }

  elYear.addEventListener('change', async () => {
    const year = elYear.value;
    elMake.innerHTML = '<option value="" disabled selected>Yükleniyor...</option>';
    elMake.disabled = true;
    elModel.innerHTML = '<option value="" disabled selected>Model</option>';
    elModel.disabled = true;
    
    try {
      const res = await fetch(`https://vpic.nhtsa.dot.gov/api/vehicles/GetMakesForVehicleType/car?format=json`);
      const data = await res.json();
      elMake.innerHTML = '<option value="" disabled selected>Marka Seçiniz</option>';
      
      const sortedMakes = data.Results.sort((a,b) => a.MakeName.localeCompare(b.MakeName));
      sortedMakes.forEach(make => {
        const opt = document.createElement('option');
        opt.value = make.MakeName;
        opt.textContent = make.MakeName;
        elMake.appendChild(opt);
      });
      elMake.disabled = false;
    } catch (e) {
      elMake.innerHTML = '<option value="" disabled selected>Hata oluştu</option>';
    }
  });

  elMake.addEventListener('change', async () => {
    const make = elMake.value;
    const year = elYear.value;
    elModel.innerHTML = '<option value="" disabled selected>Yükleniyor...</option>';
    elModel.disabled = true;

    try {
      const res = await fetch(`https://vpic.nhtsa.dot.gov/api/vehicles/GetModelsForMakeYear/make/${make}/modelyear/${year}?format=json`);
      const data = await res.json();
      
      elModel.innerHTML = '<option value="" disabled selected>Model Seçiniz</option>';
      
      if (data.Results.length === 0) {
        elModel.innerHTML = '<option value="" disabled>Model bulunamadı</option>';
        const opt = document.createElement('option');
        opt.value = 'Diğer'; opt.textContent = 'Diğer';
        elModel.appendChild(opt);
      } else {
        const sortedModels = data.Results.sort((a,b) => a.Model_Name.localeCompare(b.Model_Name));
        sortedModels.forEach(model => {
          const opt = document.createElement('option');
          opt.value = model.Model_Name;
          opt.textContent = model.Model_Name;
          elModel.appendChild(opt);
        });
      }
      elModel.disabled = false;
    } catch (e) {
      elModel.innerHTML = '<option value="" disabled selected>Hata oluştu</option>';
    }
  });

  function validateStep(step) {
    if (step === 1) {
      const name = document.getElementById('f-name');
      const phone = document.getElementById('f-phone');
      let valid = true;
      if (!name.value.trim()) { name.classList.add('is-invalid'); document.getElementById('err-name').style.display = 'block'; valid = false; }
      else { name.classList.remove('is-invalid'); document.getElementById('err-name').style.display = 'none'; }
      
      if (!phoneInput.isValidNumber()) { phone.classList.add('is-invalid'); document.getElementById('err-phone').style.display = 'block'; valid = false; }
      else { phone.classList.remove('is-invalid'); document.getElementById('err-phone').style.display = 'none'; }
      if (valid) nextStep(2);
    }
    if (step === 2) {
      const year = document.getElementById('f-year').value;
      const make = document.getElementById('f-make').value;
      const model = document.getElementById('f-model').value;
      const errCar = document.getElementById('err-car');
      
      if (!year || !make || !model) { 
        errCar.style.display = 'block';
      } else { 
        errCar.style.display = 'none';
        nextStep(3); 
      }
    }
    if (step === 4) {
      const hizmet = document.querySelector('input[name="hizmet"]:checked');
      const paket = document.querySelector('input[name="paket"]:checked');
      if (!hizmet || !paket) { document.getElementById('err-hizmet').style.display = 'block'; }
      else { document.getElementById('err-hizmet').style.display = 'none'; submitForm(); }
    }
  }

  function nextStep(step) {
    for (let i = 1; i <= TOTAL_STEPS; i++) {
      const panel = document.getElementById('panel-' + i);
      const dot   = document.getElementById('step-dot-' + i);
      if (panel) panel.classList.toggle('active', i === step);
      if (dot) {
        dot.classList.remove('active','done');
        if (i === step) dot.classList.add('active');
        else if (i < step) dot.classList.add('done');
      }
    }
    currentStep = step;
    document.querySelector('.view-form').scrollTo({ top: 0, behavior: 'smooth' });
  }

  function submitForm() {
    const formData = new FormData();
    formData.append('name', document.getElementById('f-name').value || '');
    formData.append('phone', phoneInput.getNumber() || '');
    formData.append('email', document.getElementById('f-email').value || '');
    
    const year = document.getElementById('f-year').value;
    const make = document.getElementById('f-make').value;
    const model = document.getElementById('f-model').value;
    formData.append('car', `${year} ${make} ${model}`);
    
    formData.append('plate', document.getElementById('f-plate').value || '');
    
    const hizmet = document.querySelector('input[name="hizmet"]:checked');
    const paket = document.querySelector('input[name="paket"]:checked');
    formData.append('service', hizmet ? hizmet.value : '');
    formData.append('package', paket ? paket.value : '');
    formData.append('note', document.getElementById('f-note').value || '');

    Object.keys(uploadedPhotos).forEach(key => formData.append(key, uploadedPhotos[key]));

    const btn = document.querySelector('#panel-4 .btn-red');
    const oldText = btn.innerHTML;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Gönderiliyor...';
    btn.disabled = true;

    fetch('/api/order', { method: 'POST', body: formData })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        document.getElementById('trackingCode').textContent = data.code;
        const trackUrl = location.origin + '/track?code=' + data.code;
        document.getElementById('trackingLink').href = trackUrl;
        nextStep(5);
      } else {
        alert('Hata: ' + data.error);
      }
    })
    .catch(err => alert('Bir hata oluştu'))
    .finally(() => {
      btn.innerHTML = oldText;
      btn.disabled = false;
    });
  }

  function previewPhoto(id) {
    const input = document.getElementById(id);
    const slot = document.getElementById('slot-' + id);
    const inner = document.getElementById('inner-' + id);
    if (!input.files[0]) return;
    const url = URL.createObjectURL(input.files[0]);
    uploadedPhotos[id] = input.files[0];
    inner.innerHTML = `<img src="${url}" class="photo-slot-preview"><div class="photo-slot-check"><i class="bi bi-check-lg"></i></div>`;
    slot.classList.add('has-photo');
  }

  function previewExtras() {
    const input = document.getElementById('ph-extra');
    Array.from(input.files).forEach((f,i) => { uploadedPhotos['extra-'+i] = f; });
    document.querySelector('.extra-slot').style.borderColor = '#000';
  }

  function copyCode() {
    const code = document.getElementById('trackingCode').textContent;
    navigator.clipboard.writeText(code).then(() => {
      const btn = document.querySelector('.copy-btn');
      btn.innerHTML = 'Kopyalandı <i class="bi bi-check-lg ms-1"></i>';
      setTimeout(() => { btn.innerHTML = 'Kodu Kopyala'; }, 2000);
    });
  }

  // ── DİĞER FONKSİYONLAR ──
  CookieConsent.run({
    guiOptions: { consentModal: { layout: 'box', position: 'bottom left', equalWeightButtons: false, flipButtons: false } },
    categories: { necessary: { enabled: true, readOnly: true }, analytics: {} },
    language: {
      default: 'tr',
      translations: {
        tr: {
          consentModal: { title: 'Çerez Bildirimi', description: 'Bu site deneyiminizi geliştirmek için çerezler kullanır.', acceptAllBtn: 'Kabul Et', rejectAllBtn: 'Reddet', showPreferencesBtn: null },
          preferencesModal: { title: 'Çerez Tercihleri', acceptAllBtn: 'Tümünü Kabul Et', rejectAllBtn: 'Tümünü Reddet', savePreferencesBtn: 'Kaydet', sections: [ { title: 'Zorunlu Çerezler', description: 'Gerekli.', linkedCategory: 'necessary' }, { title: 'Analitik Çerezler', description: 'Kullanım.', linkedCategory: 'analytics' } ] }
        }
      }
    }
  });

  const glow = document.getElementById('cursorGlow');
  document.addEventListener('mousemove', e => {
    glow.style.left = e.clientX + 'px';
    glow.style.top  = e.clientY + 'px';
  });
</script>
</body>
</html>