                <div style="width:80px;height:80px;border-radius:50%;background:#f0f0f0;display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;">
                  <i class="bi bi-check-lg" style="font-size:2.5rem;color:#000;"></i>
