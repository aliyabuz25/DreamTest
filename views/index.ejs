              <div style="font-weight: 500; margin-bottom: 0.5rem; font-size: 0.95rem; color: var(--muted);">İşlem Türü</div>
              <div class="service-opts mb-4">
                <% const opts = ['Karbon Fiber Kaplama','Plastik 3D İşleme','Bodykit Takımı','Fiber Kit Üretimi','Özel Tasarım'];
