                    <div class="photo-slot-inner" id="inner-<%= a.id %>">
                      <i class="bi bi-<%= a.icon %>"></i>
                      <span><%= a.label %></span>
                    </div>
                  </label>
                <% }); %>
                <label class="photo-slot extra-slot">
