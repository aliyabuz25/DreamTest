<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>DreamStudio — İlk Kurulum</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet">
<style>
:root { --bg:#050505; --bg2:#0a0a0a; --bg3:#0f0f0f; --border:#1f1f1f; --accent:#e63946; --font:-apple-system,'SF Pro Display',sans-serif; }
* { box-sizing:border-box; margin:0; padding:0; }
body { background:var(--bg); color:#e0e0e0; font-family:var(--font); min-height:100vh; display:flex; align-items:center; justify-content:center; }
.setup-box { width:100%; max-width:420px; padding:2rem; }
.logo { text-align:center; font-size:1.8rem; font-weight:800; color:#fff; margin-bottom:0.3rem; letter-spacing:-0.02em; }
.logo span { color:var(--accent); }
.sub { text-align:center; color:#888; font-size:0.85rem; margin-bottom:0.5rem; }
.badge-setup { display:inline-block; background:rgba(230,57,70,0.1); border:1px solid rgba(230,57,70,0.2); color:var(--accent); border-radius:20px; padding:0.3rem 0.8rem; font-size:0.75rem; font-weight:600; text-align:center; width:100%; margin-bottom:2rem; letter-spacing:0.05em; }
.form-control { background:var(--bg3) !important; border:1px solid var(--border) !important; color:#fff !important; border-radius:10px !important; padding:0.8rem 1rem !important; margin-bottom:1rem; transition:all 0.2s; }
.form-control:focus { border-color:var(--accent) !important; box-shadow:0 0 0 3px rgba(230,57,70,0.1) !important; }
.form-control::placeholder { color:#555 !important; }
.btn-setup { background:var(--accent); color:#fff; border:none; border-radius:10px; width:100%; padding:0.8rem; font-weight:600; font-size:0.9rem; transition:background 0.2s; cursor:pointer; }
.btn-setup:hover { background:#c1121f; }
.alert { background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.2); color:#f87171; border-radius:10px; padding:0.8rem; font-size:0.85rem; text-align:center; margin-bottom:1.5rem; }
.hint { color:#555; font-size:0.78rem; margin-top:-0.5rem; margin-bottom:1rem; padding-left:0.2rem; }
.divider { border-color:#1f1f1f; margin:1.5rem 0; }
.security-note { background:rgba(34,197,94,0.05); border:1px solid rgba(34,197,94,0.15); border-radius:10px; padding:0.8rem 1rem; font-size:0.8rem; color:#4ade80; margin-top:1.5rem; }
.security-note i { margin-right:0.4rem; }
</style>
</head>
<body>
<div class="setup-box">
  <div class="logo">Dream<span>Studio</span></div>
  <div class="sub">Yönetim Paneli</div>
  <div class="badge-setup">İLK KURULUM</div>

  <% if (error) { %>
    <div class="alert"><i class="ri-error-warning-line"></i> <%= error %></div>
  <% } %>

  <form method="POST" action="/admin/setup" autocomplete="off">
    <input type="text" name="username" class="form-control" placeholder="Kullanıcı Adı" required autofocus minlength="3" maxlength="32" autocomplete="off">
    <div class="hint">En az 3 karakter</div>

    <input type="password" name="password" class="form-control" placeholder="Şifre" required minlength="8" autocomplete="new-password">
    <div class="hint">En az 8 karakter, 1 büyük harf ve 1 rakam içermeli</div>

    <input type="password" name="confirm" class="form-control" placeholder="Şifreyi Tekrarla" required autocomplete="new-password">

    <button type="submit" class="btn-setup">
      <i class="ri-shield-check-line"></i> Yönetici Hesabı Oluştur
    </button>
  </form>

  <div class="security-note">
    <i class="ri-lock-line"></i> Bu sayfa yalnızca ilk kurulumda erişilebilir. Hesap oluşturulduktan sonra otomatik olarak kapatılır.
  </div>
</div>
</body>
</html>